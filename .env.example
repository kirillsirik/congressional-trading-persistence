# Settings for the sample-construction and analysis stages; `make test` and `make exhibits` need none.
# Copy to .env, edit, and export before running a restricted stage:  set -a; . ./.env; set +a

# Root of the restricted project data: data/raw/ (CRSP, factors), data/processed/ (market panel),
# capitol_trades/ (vendor snapshots).
DROPBOX_PROJECT_ROOT=/path/to/project-data

# Official-filing store: written by `make collect-official`, read by `make sample`. Keep it outside
# any synced folder (it holds a SQLite database).
OFFICIAL_DATA_ROOT=/path/to/official_store
OFFICIAL_STORE_DIR=/path/to/official_store

# Contact address sent in the User-Agent header when collecting official filings.
OFFICIAL_CONTACT=you@example.edu

# Set to true only after reading the Senate eFD terms of use (efdsearch.senate.gov).
SENATE_EFD_USAGE_ACKNOWLEDGED=false
